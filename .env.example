VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required for local development; production may use the same custom hostname
# or the deployment's /functions reverse proxy.
# Example: https://edge.itemtraxx.com
VITE_EDGE_PROXY_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
VITE_SENTRY_ENABLE_LOGS=true
VITE_POSTHOG_PROJECT_TOKEN=
# Production managed reverse proxy hostname:
VITE_POSTHOG_HOST=https://j.itemtraxx.com
# Public Intercom Messenger workspace ID from the Intercom settings URL
VITE_INTERCOM_APP_ID=
# Server-side Supabase Edge Function secret from Intercom Messenger Security.
# Set this with `supabase secrets set`, never as a VITE_* browser variable.
ITX_INTERCOM_MESSENGER_SECRET=

# Server-side Resend sender identities. Keep these out of VITE_* variables;
# set them locally in the ignored project-root .env or in Supabase Edge
# Function Secrets for production. ITX_EMAIL_FROM remains the shared fallback.
# ITX_EMAIL_NOREPLY is reserved for direct no-reply transactional sends;
# Supabase Auth mailer templates are configured separately in Supabase.
ITX_EMAIL_SUPPORT="ItemTraxx Support <support@itemtraxx.com>"
ITX_EMAIL_SALES="ItemTraxx Sales <sales@itemtraxx.com>"
ITX_EMAIL_PRIVACY="ItemTraxx Privacy <privacy@itemtraxx.com>"
ITX_EMAIL_SECURITY="ItemTraxx Security <security@itemtraxx.com>"
ITX_EMAIL_LEGAL="ItemTraxx Legal <legal@itemtraxx.com>"
ITX_EMAIL_NOTIFICATIONS="ItemTraxx Notifications <notifications@itemtraxx.com>"
ITX_EMAIL_NOREPLY="ItemTraxx no-reply <noreply@itemtraxx.com>"
ITX_EMAIL_FROM="ItemTraxx Support <support@itemtraxx.com>"
VITE_LOGO_URL=
VITE_BRAND_LOGO_LIGHT_URL=
VITE_BRAND_LOGO_DARK_URL=
VITE_LEGAL_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
# Local development example:
# ITX_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Shared environment example:
# ITX_ALLOWED_ORIGINS=https://itemtraxx.com,https://www.itemtraxx.com,https://status.itemtraxx.com,https://internal.itemtraxx.com,https://app.itemtraxx.com,https://dennis-dev.itemtraxx.com,https://leo-dev.itemtraxx.com,https://dev.itemtraxx.com,https://preview.itemtraxx.com,https://staging.itemtraxx.com,https://itxdemo.app.itemtraxx.com
ITX_ALLOWED_ORIGINS=
# VITE_TENANT_LOGIN_FUNCTION=tenant-login
# VITE_LOGIN_NOTIFY_FUNCTION=login-notify
# VITE_STATUS_FUNCTION=system-status
# VITE_SUPER_ADMIN_ACCESS_CODE=
# ITX_ENVIRONMENT=development
# ITX_LOGIN_NOTIFY_ENABLED=true
# ITX_ITEMTRAXX_KILLSWITCH_ENABLED=false
# ITX_CLIENT_ERROR_SLACK_WEBHOOK_URL=
