{
  "name": "itemtraxx-edge-proxy",
  "private": true,
  "version": "0.0.0",
  "description": "ItemTraxx Cloudflare edge proxy Worker. Kept as its own manifest so Workers Builds installs only wrangler + typescript instead of the full application dependency tree.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "types:check": "wrangler types worker-configuration.d.ts --config wrangler.toml --env-file .dev.vars.example --strict-vars false --check",
    "deploy": "wrangler deploy --config wrangler.toml",
    "versions:upload": "wrangler versions upload --config wrangler.toml"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.22",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/sso": "1.7.12",
    "@supabase/supabase-js": "2.112.4",
    "better-auth": "1.7.12",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "wrangler": "^4.143.1"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "miniflare@>=5.20260926.1-alpha": {
      "sharp": "0.35.5"
    },
    "node-rsa": "2.0.0",
    "undici": "7.30.1",
    "zod": "4.6.7",
    "workerd": "1.20261027.1"
  }
}
