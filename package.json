{
  "name": "itemtraxx-code",
  "private": true,
  "version": "0.0.0",
  "description": "ItemTraxx application",
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "postbuild": "node ./scripts/prerender-public.mjs && node ./scripts/upload-posthog-sourcemaps.mjs",
    "preview": "npm run build && wrangler dev",
    "test:prerender": "node --test scripts/prerender-public.test.mjs",
    "test:e2e": "playwright test",
    "test:security:adversarial": "node ./scripts/test-security-adversarial.mjs",
    "test:security:baseline": "node ./scripts/generate-security-baseline.mjs",
    "supabase:migrations:drift": "node ./scripts/supabase-migration-drift.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "bones:build": "boneyard-js build",
    "security:audit": "\"$npm_node_execpath\" ./scripts/security-audit.mjs",
    "security:gate": "\"$npm_node_execpath\" ./scripts/security-audit.mjs",
    "security:verify": "deno test --no-check --allow-env --allow-read supabase/functions/_shared/incidentOutcome_test.ts supabase/functions/_shared/securityVerification_test.ts",
    "security:sbom": "bash ./scripts/generate-sbom.sh",
    "perf:budget": "node ./scripts/check-bundle-budget.mjs",
    "perf:css-boundary": "node ./scripts/check-public-css-boundary.mjs",
    "perf:initial": "node ./scripts/check-initial-load-budget.mjs",
    "perf:initial:report": "node ./scripts/check-initial-load-budget.mjs --report-only",
    "perf:landing-network": "node ./scripts/check-landing-network.mjs",
    "perf:images": "node ./scripts/check-image-budget.mjs",
    "perf:report": "node ./scripts/perf-report.mjs",
    "worker:types": "cd cloudflare/edge-proxy && wrangler types worker-configuration.d.ts --config wrangler.toml --env-file .dev.vars.example --strict-vars false",
    "worker:types:check": "cd cloudflare/edge-proxy && wrangler types worker-configuration.d.ts --config wrangler.toml --env-file .dev.vars.example --strict-vars false --check",
    "worker:typecheck": "npm run worker:types:check && tsc -p cloudflare/edge-proxy/tsconfig.json",
    "worker:test": "deno test --node-modules-dir=none --allow-env --no-check --frozen cloudflare/edge-proxy/src/*_test.ts && node --test scripts/worker-kill-switch-config.test.mjs",
    "docs:edge-schemas": "node ./scripts/generate-edge-schemas.mjs",
    "docs:edge-openapi": "node ./scripts/generate-edge-schemas.mjs",
    "docs:edge-reference": "node ./scripts/generate-edge-reference.mjs",
    "devops:check:edge-coverage": "node ./scripts/check-edge-function-coverage.mjs",
    "devops:check:empty-catches": "node ./scripts/check-empty-catches.mjs",
    "devops:check:deno-coverage": "node ./scripts/check-deno-coverage.mjs",
    "devops:check:edge-action-parity": "node ./scripts/check-edge-action-contract-parity.mjs",
    "devops:check:edge-contract-drift": "node ./scripts/check-edge-contract-drift.mjs",
    "devops:check:sql-coupling": "node ./scripts/check-sql-function-coupling.mjs",
    "devops:bump-hub-sha": "node ./scripts/bump-devops-hub-sha.mjs",
    "analytics:report": "node ./scripts/vercel-analytics-agent.mjs",
    "observability:upload-sourcemaps": "node ./scripts/upload-posthog-sourcemaps.mjs",
    "email:preview": "node ./scripts/generate-email-previews.mjs",
    "deploy:supabase:functions": "python3 ./scripts/deploy-supabase-functions.py",
    "deploy:cloudflare:worker": "bash ./scripts/deploy-cloudflare-worker.sh",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.27",
    "@better-auth/passkey": "1.7.18",
    "@better-auth/sso": "1.7.18",
    "@fontsource/inter": "^5.3.0",
    "@intercom/messenger-js-sdk": "^0.0.20",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "better-auth": "1.7.18",
    "boneyard-js": "^1.10.0",
    "dompurify": "3.4.17",
    "jose": "6.2.15",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "marked": "18.1.3",
    "posthog-js": "1.447.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@playwright/test": "^1.65.0",
    "@posthog/cli": "0.19.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "tar": "^7.5.21",
    "tar-fs": "^2.1.5",
    "protobufjs@<=8.2.0": "8.2.0",
    "ws": "^8.20.1",
    "dompurify": "3.4.17",
    "es-module-lexer": "3.0.2",
    "fast-uri": "3.1.9",
    "glob": "14.0.3",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "8.12.4",
    "js-yaml": "4.3.2",
    "node-gyp": "^13.0.1",
    "brace-expansion": "2.1.7",
    "better-call": "1.4.5",
    "@better-fetch/fetch": "1.3.3",
    "nanoid": "5.1.16",
    "ip-address": "^10.3.1",
    "workerd": "1.20261027.1",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.4.0",
    "minimatch": "11.0.4",
    "node-rsa": "2.0.0",
    "yargs": "18.1.0"
  },
  "allowScripts": {
    "@posthog/cli@0.18.9": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "libxmljs2@0.37.0": true,
    "workerd@1.20261027.1": true
  }
}
