{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "itemtraxx-sgw-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SUPABASE_URL": "https://nwuhjxicaopkmqydjlas.supabase.co",
    "SGW_PROVISIONING_ENABLED": "false"
  },
  "kv_namespaces": [
    { "binding": "KEYS", "id": "d5f35be5620148d89c68218cd4e8c520" }
  ],
  "r2_buckets": [
    { "binding": "KMS_BACKUPS", "bucket_name": "itemtraxx-kms-backups-staging" }
  ]
}
