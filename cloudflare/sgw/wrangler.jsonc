{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "itemtraxx-sgw",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20", // compatibility date for the worker
  "compatibility_flags": ["nodejs_compat"],
  // Preview builds have no production keys or KV binding.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://mlaspkufocikfcbjgpof.supabase.co"
    }
  },
  "vars": {
    "SUPABASE_URL": "https://mlaspkufocikfcbjgpof.supabase.co", // prod db url
    "SGW_REQUIRE_KMS_BACKUP": "true"
  },
  "routes": [
    {
      "pattern": "sgw.itemtraxx.com", // security gateway route domain
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "KEYS",
      "id": "950e0d5b30d54475b0afbfcbc990c72b" // kv namespace for the keys
    }
  ],
  "r2_buckets": [
    {
      "binding": "KMS_BACKUPS",
      "bucket_name": "itemtraxx-kms-backups"
    }
  ]
}
